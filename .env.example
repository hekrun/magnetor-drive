# Copy to .env and edit. .env is git-ignored.
MAGNETOR_ADMIN_USER=admin
MAGNETOR_ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Set to true when served over HTTPS (recommended behind a reverse proxy)
MAGNETOR_COOKIE_SECURE=false
MAGNETOR_MAX_UPLOAD_MB=10240
MAGNETOR_TORRENT_DHT=true
# Comma-separated tracker URLs (optional)
MAGNETOR_TORRENT_TRACKERS=
